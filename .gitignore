# mac shit
.DS_Store

# nyc test coverage
.nyc_output
coverage/

# Dependency directories
node_modules/

# Optional npm cache directory
.npm
npm-debug.log

# Optional eslint cache
.eslintcache

# vscode
/.vscode
*.pid

# JetBrains IDEs (IntelliJ/WebStorm/etc.)
.idea/
*.iml

# Tests temporary
.test_tmp

# Local-only scratch/credential material - files named *.local.* are never
# meant to be committed (e.g. a *.local.key EBICS key file, or a
# *.local.xml dump of a signed request used while debugging against a real
# bank). Anyone extending this library's live-bank testing should keep
# using this naming convention rather than inventing a new one.
*.local.*

# One-off verification scripts and their sample data (e.g. a script that
# submits a live test payment against a real bank, and the payment file it
# uploads) - unlike examples/, nothing under here is curated/documented for
# other users, so none of it is meant to be committed. Put ad-hoc scripts
# and fixtures used to manually verify something against a live bank here.
/local/
