<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">

<head>
	<meta http-equiv="content-type" content="text/html; charset=utf-8">
	<meta charset="UTF-8" />
	<title>EBICS ini</title>
</head>

<body>
	<div>
		<h2>EBICS-Initialisierungsbrief (INI)</h2>
		<table>
			<tr>
				<td>Datum</td>
				<td>{{ today }}</td>
			</tr>
			<tr>
				<td>Uhrzeit</td>
				<td>{{ now }}</td>
			</tr>
			<tr>
				<td>Empfänger</td>
				<td>{{ bankName }}</td>
			</tr>
			<tr>
				<td>User-ID</td>
				<td>{{ userId }}</td>
			</tr>
			<tr>
				<td>Kunden-ID</td>
				<td>{{ partnerId }}</td>
			</tr>
		</table>
		<p>Zertifikat für die elektronische Unterschrift (A006)</p>
		<table>
			<tr>
				<td>Betreff (CN)</td>
				<td>{{ certSubject A006 }}</td>
			</tr>
			<tr>
				<td>Seriennummer</td>
				<td><code>{{ certSerial A006 }}</code></td>
			</tr>
			<tr>
				<td>Gültig bis</td>
				<td>{{ certValidUntil A006 }}</td>
			</tr>
		</table>
		<p>SHA-256-Fingerabdruck des Zertifikats:</p>
		<p>
			<code>{{ certDigest A006 }}</code>
		</p>
		<p>Ich bestätige hiermit das obige Zertifikat für meine elektronische Unterschrift.</p>
		<br/>
		<br/>
		<br/>
		<br/>
		<table>
			<tr>
				<td>_________________________</td>
				<td>_________________________</td>
				<td>_________________________</td>
			</tr>
			<tr>
				<td>Ort/Datum</td>
				<td>Name/Firma</td>
				<td>Unterschrift</td>
			</tr>
		</table>
	</div>
	<div style="page-break-after:always"></div>
	<h2>EBICS-Initialisierungsbrief (HIA) - Seite 1/2</h2>
	<table>
		<tr>
			<td>Datum</td>
			<td>{{ today }}</td>
		</tr>
		<tr>
			<td>Uhrzeit</td>
			<td>{{ now }}</td>
		</tr>
		<tr>
			<td>Empfänger</td>
			<td>{{ bankName }}</td>
		</tr>
		<tr>
			<td>User-ID</td>
			<td>{{ userId }}</td>
		</tr>
		<tr>
			<td>Kunden-ID</td>
			<td>{{ partnerId }}</td>
		</tr>
	</table>
	<div>
		<p>Zertifikat für den Authentifikationsschlüssel (X002)</p>
		<table>
			<tr>
				<td>Betreff (CN)</td>
				<td>{{ certSubject X002 }}</td>
			</tr>
			<tr>
				<td>Seriennummer</td>
				<td><code>{{ certSerial X002 }}</code></td>
			</tr>
			<tr>
				<td>Gültig bis</td>
				<td>{{ certValidUntil X002 }}</td>
			</tr>
		</table>
		<p>SHA-256-Fingerabdruck des Zertifikats:</p>
		<p>
			<code>{{ certDigest X002 }}</code>
		</p>
		<p> Fortsetzung auf Seite 2 ...</p>
		<div style="page-break-after:always"></div>
		<h2>EBICS-Initialisierungsbrief (HIA) - Seite 2/2</h2>
		<table>
			<tr>
				<td>Datum</td>
				<td>{{ today }}</td>
			</tr>
			<tr>
				<td>Uhrzeit</td>
				<td>{{ now }}</td>
			</tr>
			<tr>
				<td>Empfänger</td>
				<td>{{ bankName }}</td>
			</tr>
			<tr>
				<td>User-ID</td>
				<td>{{ userId }}</td>
			</tr>
			<tr>
				<td>Kunden-ID</td>
				<td>{{ partnerId }}</td>
			</tr>
		</table>
	</div>
	<div>
		<p>Zertifikat für den Verschlüsselungsschlüssel (E002)</p>
		<table>
			<tr>
				<td>Betreff (CN)</td>
				<td>{{ certSubject E002 }}</td>
			</tr>
			<tr>
				<td>Seriennummer</td>
				<td><code>{{ certSerial E002 }}</code></td>
			</tr>
			<tr>
				<td>Gültig bis</td>
				<td>{{ certValidUntil E002 }}</td>
			</tr>
		</table>
		<p>SHA-256-Fingerabdruck des Zertifikats:</p>
		<p>
			<code>{{ certDigest E002 }}</code>
		</p>
		<p>Ich bestätige hiermit die obigen Zertifikate für meinen EBICS-Zugang.</p>
		<br/>
		<br/>
		<br/>
		<br/>
		<table>
			<tr>
				<td>_________________________</td>
				<td>_________________________</td>
				<td>_________________________</td>
			</tr>
			<tr>
				<td>Ort/Datum</td>
				<td>Name/Firma</td>
				<td>Unterschrift</td>
			</tr>
		</table>
	</div>
</body>

</html>
